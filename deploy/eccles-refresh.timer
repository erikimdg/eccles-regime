[Unit]
Description=ECCLES pre-09:00 KST collection and observed availability

[Timer]
OnCalendar=Mon..Sat *-*-* 07:40..59:00 Asia/Seoul
OnCalendar=Mon..Sat *-*-* 08,09:*:00 Asia/Seoul
OnCalendar=Mon..Sat *-*-* 10:00..40:00 Asia/Seoul
OnCalendar=Mon..Sat *-*-* 12,16:20:00 Asia/Seoul
Persistent=true
AccuracySec=1s
RandomizedDelaySec=0
Unit=eccles-refresh.service

[Install]
WantedBy=timers.target
